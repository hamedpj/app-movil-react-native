{
  "expo": {
    "name": "SupplyChain Marine",
    "slug": "supplychain-marine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoApp.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoApp.png",
        "backgroundColor": "#1a237e"
      },
      "package": "com.hamedpj11.supplychainmarine",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_YOUR_REAL_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/logoApp.png"
    },
    "extra": {
      "eas": {
        "projectId": "8c28e8f9-7e32-4eda-b7fb-678d7776a887"
      }
    }
  }
}
